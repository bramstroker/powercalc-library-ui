{
  "name": "powercalc-library-viewer",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14",
    "@emotion/styled": "^11.14",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@mui/x-charts": "^9.0.0",
    "@mui/x-data-grid": "^9.0.0",
    "@mui/x-date-pickers": "^9.0.0",
    "@react-router/node": "^8.3.0",
    "@sentry/react": "^10.38.0",
    "@sentry/vite-plugin": "^5.0.0",
    "@tanstack/react-query": "^5.29",
    "@vitejs/plugin-react": "^6.0.0",
    "ajv": "^8.17.1",
    "isbot": "^5.2.1",
    "react": "^19.0",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.0",
    "react-router": "^8.3.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/generate-sitemap.mjs",
    "build:prerender-all": "PRERENDER_MODE=all react-router build && node scripts/generate-sitemap.mjs",
    "cache:warm": "node scripts/warm-cloudflare-cache.mjs",
    "preview": "vite preview",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "type-check": "react-router typegen && tsc --noEmit"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "^8.3.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.0",
    "@types/react-dom": "^19.0",
    "@typescript-eslint/eslint-plugin": "^8.44",
    "@typescript-eslint/parser": "^8.44",
    "eslint": "^10.0.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^17.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.5",
    "typescript-eslint": "^8.51.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
